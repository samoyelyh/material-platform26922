# ============================================================================
# material-platform 前端生产镜像（multi-stage build）
#
#   Stage 1 (build): Node → npm ci → tsc + vite build → dist
#   Stage 2 (run)  : nginx 静态托管 + /api 反向代理（同源，避免 CORS / 硬编码地址）
#
# 用法（由 docker-compose 调用）：
#   docker build -f Dockerfile.frontend \
#     --build-arg VITE_MATERIAL_API_BASE=/api \
#     --build-arg VITE_MATERIAL_API=1 \
#     -t material-platform-frontend .
#
# 生产不运行 vite dev server；Nginx 提供 SPA fallback + /api 反代。
# ============================================================================
FROM node:22-alpine AS build

WORKDIR /app

# 生产构建参数（由 compose / CI 传入；VITE_MATERIAL_API_BASE 用相对 /api，
# 让浏览器走同源 → Nginx 反代，不硬编码任何 192.168.x.x 地址）
ARG VITE_MATERIAL_API_BASE=/api
ARG VITE_MATERIAL_API=1

ENV VITE_MATERIAL_API_BASE=${VITE_MATERIAL_API_BASE} \
    VITE_MATERIAL_API=${VITE_MATERIAL_API}

# 先装依赖，利用 Docker 层缓存
COPY package.json package-lock.json ./
# 修复 lockfile 中指向已失效内部镜像（npm.mirrors.msh.team）的 resolved URL，
# 统一改为官方 registry，保证 npm ci 可成功拉取（不改仓库文件）。
RUN sed -i 's|https://npm\.mirrors\.msh\.team|https://registry.npmjs.org|g' package-lock.json \
    && npm ci --no-audit --no-fund

# 构建
COPY . .
RUN npm run build

# 生产无 Mock：public/mock 演示图片随 Vite 复制进 dist，这里剔除
RUN rm -rf dist/mock

# ---------------- 运行阶段 ----------------
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
