# 部署用 Dockerfile（不修改仓库源码）
# ============================================================
# 仓库 requirements.txt 缺失 numpy（image_search/embedder.py、
# orders/matcher.py 均硬依赖），这里在部署构建时补齐。
# 仅用于本机部署，不提交回仓库。
# ============================================================
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt numpy

COPY . .

EXPOSE 8000

# 默认命令由 docker-compose 覆盖（先 alembic upgrade head 再起服务）
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
